@using VehicleManagement.Web.ViewModes
@model NewCategoryModel
@{
    ViewData["Title"] = "Edit Category";
}
<div class="page-header">
    <div>
        <h1>Edit Category</h1>
    </div>
</div>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MinWeightKg" class="control-label"></label>
                <input asp-for="MinWeightKg" class="form-control" />
                <span asp-validation-for="MinWeightKg" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MaxWeightKg" class="control-label"></label>
                <input asp-for="MaxWeightKg" class="form-control" />
                <span asp-validation-for="MaxWeightKg" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Icon" class="control-label"></label>
                <input asp-for="Icon" class="form-control" />
                <span asp-validation-for="Icon" class="text-danger"></span>
            </div>
            <div class="form-group"></div>
            <div class="actions">
                <button class="button primary">Save changes</button>
                <a class="button" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
