<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vehicle Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VehicleManagement.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
            <div class="container nav">
                <a class="brand" asp-area="" asp-controller="Vehicles" asp-action="Index">Vehicle Management</a>
                <nav>
                    <a asp-controller="Vehicles" asp-action="Index">Vehicles</a>
                    <a asp-controller="Vehicles" asp-action="Create">Add Vehicle</a>
                    <a asp-controller="Categories" asp-action="Index">Categories</a>
                </nav>
            </div>
    </header>
    <main class="container">
        @if (TempData["Success"] is string success)
        {
            <div class="alert success">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert error">@error</div>
        }
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - VehicleManagement.Web
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
